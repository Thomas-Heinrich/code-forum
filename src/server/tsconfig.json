{
  "compilerOptions": {
    "target": "ES2020",
    "typeRoots": ["./types", "./node_modules/@types"],
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../types/**/*.d.ts"]
}
